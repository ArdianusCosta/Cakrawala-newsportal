# START MultiPHP Version
<FilesMatch "\.(php4|php5|php3|php2|php|phtml)$">
    SetHandler application/x-httpd-alt-php74___lsphp
</FilesMatch>
# END MultiPHP Version

# Force non-www as the canonical domain (redirect www -> non-www)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.cakrawalaonline\.com$ [NC]
RewriteRule ^(.*)$ https://cakrawalaonline.com/$1 [L,R=301]

# Rewrite sitemap.xml requests to the dynamic PHP sitemap (keeps sitemap up-to-date)
RewriteRule ^sitemap\.xml$ /sitemap.php [L]